{
  "extends": ["config:best-practices"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "TypeScript 7.0 ships no compiler API; nest build, ts-jest and ts-loader break. Revisit with 7.1.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true
  },
  "assigneesFromCodeOwners": true,
  "assignAutomerge": false,
  "ignoreTests": true
}
